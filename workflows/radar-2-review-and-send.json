    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "claude-haiku-5-5",
          "mode": "id"
        },
        "messages": {
          "values": [
            {
              "content": "=You write short Slack messages from Spine, a benefits and compliance team, to a startup's founder.\n\nWrite a message about the requirement below.\n- Use only the facts in REQUIREMENT and FACTS. Don't add requirements, numbers, dates, penalties or deadlines.\n- Don't do date math. Describe timing the way REQUIREMENT does.\n- If anything is unclear, say Spine will confirm the details.\n- Say what changed and what's required. If OWNER is Spine, say Spine is handling it. If OWNER is Client, say what their team needs to do and that Spine can help.\n- Under 90 words, in plain English, with no emoji. Don't phrase it as legal advice.\n- End with the SOURCE link on its own line.\n\nTITLE: {{ $json.title }}\nREQUIREMENT: {{ $json.requirement }}\nFACTS: {{ JSON.stringify($json.facts) }}\nOWNER: {{ $json.owner }}\nSOURCE: {{ $json.source_url }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3f8250e6-e004-4fab-9dcd-9f6b0296c7dd",
      "name": "Draft message",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Check the draft: a tripwire for invented facts. Code node, Mode: Run Once for All Items.\nconst alert = $('Alert in').first().json;\nconst out = $input.first().json;\n\n// The model node's output shape differs by node and version: take the first text found.\nconst draft = String(\n  out.content?.find?.(c => c.type === 'text')?.text ?? out.text ?? out.output ?? out.message?.content ?? ''\n).trim();\n\n// Every number in the draft must already appear in the rule or the facts.\nconst numbersIn = s => (String(s).match(/\\d[\\d,.]*/g) || [])\n  .map(n => n.replace(/[.,]+$/, '').replace(/,/g, ''))\n  .map(n => String(Number(n))); // \"05\" and \"5\" compare equal\nconst allowed = new Set(numbersIn(\n  [alert.title, alert.requirement, alert.source_name, alert.source_url, JSON.stringify(alert.facts)].join(' ')\n));\nconst unexpected = [...new Set(numbersIn(draft))].filter(n => !allowed.has(n));\n\nconst problems = [];\nif (!alert.requirement || !alert.source_url) problems.push('The alert arrived without its rule details, so there was nothing to draft from.');\nif (!draft) problems.push('The model returned no text.');\nif (unexpected.length) problems.push(`Numbers that aren't in the rule or facts: ${unexpected.join(', ')}.`);\nif (alert.source_url && !draft.includes(alert.source_url)) problems.push('The source link is missing.');\n\nreturn [{ json: { draft, passed: problems.length === 0, problems: problems.join(' ') } }];\n"
      },
